n_selected == 0                       ~ "Not selected"
),
agg_class = factor(
agg_class,
levels = c("All four strategies",
"Impact-based only",
"Spatial proxy only",
"Mixed",
"Not selected")
)
)
# Quick sanity check: how does the data distribute across categories?
print(table(pu$agg_class, useNA = "ifany"))
# Write out the aggregated shapefile for ArcGIS Pro
sf::st_write(
pu,
"E:/kent/R2R/GIS/PUsfinal2025/planning_units_aggregated.shp",
delete_layer = TRUE
)
